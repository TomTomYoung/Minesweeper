        //             for (let i = Math.max(0, r - 1); i <= Math.min(gameState.rows - 1, r + 1); i++) {
        //                 for (let j = Math.max(0, c - 1); j <= Math.min(gameState.cols - 1, c + 1); j++) {
        //                     // 自分自身は除外
        //                     if (i === r && j === c) continue;
        //                     const neighbor = gameState.board[i][j];
                            
        //                     // 壁は自動オープンの対象外。旗や既に開かれているセルも除外
        //                     if (!neighbor.isRevealed && !neighbor.isFlagged && !neighbor.isWall) {
        //                         queue.push([i, j]);
        //                     }
        //                 }
        //             }
        //         }
        //     }
            
        //     // 全セルが開かれているかをチェック
        //     checkWinCondition();
        // }


        // セルを開く（壁セルはここでは処理せず、revealWallClusterへ委ねる）
        function revealCell(row, col) {

            console.log("revealCell called:", row, col, gameState.board[row][col]);

            
            const cell = gameState.board[row][col];

            // 既に開かれているか、旗が立っている場合は何もしない
            if (cell.isRevealed || cell.isFlagged) return;
            
            // 壁の場合はBFS処理に入らない
            if (cell.isWall) {
                // ※ここでrevealWallClusterに切り替えるか、何もしないかは設計次第
                return;
            }
            
            // 幅優先探索（BFS）による自動オープン処理
            const queue = [];
            queue.push([row, col]);
            
            while (queue.length > 0) {
                const [r, c] = queue.shift();
                const currentCell = gameState.board[r][c];
                
                // すでに開かれているか旗が立っているならスキップ
                if (currentCell.isRevealed || currentCell.isFlagged) continue;
                
                // 万が一、BFS中に壁セルが混入した場合は除外
                if (currentCell.isWall) continue;
                
                currentCell.isRevealed = true;
                gameState.revealedCells++;
                updateCellUI(r, c);
                
                // 地雷を踏んだ場合はゲームオーバー
                if (currentCell.isMine) {
                    gameOver(false);
                    return;
                }
                
                // 周囲８方向のうち、数字が0なら隣接セルを展開（※非壁セルのみ）
                if (currentCell.neighborMines === 0) {
                    for (let i = Math.max(0, r - 1); i <= Math.min(gameState.rows - 1, r + 1); i++) {
                        for (let j = Math.max(0, c - 1); j <= Math.min(gameState.cols - 1, c + 1); j++) {
                            if (i === r && j === c) continue;
                            const neighbor = gameState.board[i][j];
                            if (!neighbor.isRevealed && !neighbor.isFlagged && !neighbor.isWall) {
                                queue.push([i, j]);
                            }
                        }
                    }
                }
            }
            
            checkWinCondition();
        }

        // 旗を切り替える
        function toggleFlag(row, col) {
            const cell = gameState.board[row][col];

            // すでに開かれているか壁の場合は何もしない
            if (cell.isRevealed || cell.isWall) return;

            if (cell.isFlagged) {
                // 旗を取り除く
                cell.isFlagged = false;
                gameState.flagsLeft++;
            } else {
                // 旗がすべて使われている場合は何もしない
                if (gameState.flagsLeft <= 0) return;
                
                // 旗を立てる
                cell.isFlagged = true;
                gameState.flagsLeft--;
            }

            // UIを更新
            updateCellUI(row, col);
            flagsLeftDisplay.textContent = gameState.flagsLeft;

            // 勝利条件をチェック
            checkWinCondition();
        }

        // セルのUIを更新
        function updateCellUI(row, col) {

            console.log("updateCellUI:", row, col, gameState.board[row][col]);


            const cell = gameState.board[row][col];
            const cellElement = document.querySelector(`[data-row="${row}"][data-col="${col}"]`);

            // クラスをリセット
            cellElement.className = 'cell';
            cellElement.textContent = '';

            if (cell.isWall) {
                //cellElement.classList.add('wall');
                if (cell.isRevealed) {
                    //cellElement.classList.add('revealed');
                    cellElement.classList.add('wall');
                }
                return;
            }

            if (cell.isRevealed) {
                cellElement.classList.add('revealed');
                
                if (cell.isMine) {
                    cellElement.classList.add('mine');
                } else if (cell.neighborMines > 0) {
                    cellElement.classList.add(`num-${cell.neighborMines}`);
                    cellElement.textContent = cell.neighborMines;
                }
            } else if (cell.isFlagged) {
                cellElement.classList.add('flagged');
            }
        }

        // すべての地雷を表示
        function revealAllMines() {
            for (let i = 0; i < gameState.rows; i++) {
                for (let j = 0; j < gameState.cols; j++) {
                    if (gameState.board[i][j].isMine) {
                        gameState.board[i][j].isRevealed = true;
                        updateCellUI(i, j);
                    }
                }
            }
        }

        // 勝利条件をチェック
        function checkWinCondition() {
            const totalCells = gameState.rows * gameState.cols;
            const nonMineCells = totalCells - gameState.mines;
            let revealedOrWallCells = gameState.revealedCells;

            // 壁のセルカウント
            for (let i = 0; i < gameState.rows; i++) {
                for (let j = 0; j < gameState.cols; j++) {
                    if (!gameState.board[i][j].isRevealed && gameState.board[i][j].isWall) {
                        revealedOrWallCells++;
                    }
                }
            }

            // すべての非地雷セルが開かれているか（壁面は開かれている必要はない）
            if (revealedOrWallCells === nonMineCells) {
                gameOver(true);
            }
        }

        // ゲーム終了
        function gameOver(isWin) {
            gameState.isGameOver = true;
            clearInterval(gameState.timerInterval);
            if (isWin) {
                messageDisplay.textContent = '勝利！おめでとうございます！';
                messageDisplay.style.color = 'green';
            } else {
                revealAllMines();
                messageDisplay.textContent = 'ゲームオーバー！';
                messageDisplay.style.color = 'red';
            }
        }
        // 配列をランダムに並べ替える
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }



        // 初期化
        initializeGame(gameConfig);

        </script>
    </body>
</html>
