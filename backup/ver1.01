        //     if (cell.isMine) {
        //         gameOver(false);
        //         return;
        //     }

        //     // 空のセルの場合、周囲のセルも自動的に開く
        //     if (cell.neighborMines === 0) {
        //         for (let i = Math.max(0, row - 1); i <= Math.min(gameState.rows - 1, row + 1); i++) {
